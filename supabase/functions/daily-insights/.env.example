# MediTrack Daily Insights — Edge Function Environment Variables
# Copy this file to .env for local development with supabase functions serve

# ─────────────────────────────────────────────
# Required: Supabase (auto-injected in production)
# ─────────────────────────────────────────────
SUPABASE_URL=https://qfgvjyhnvmcczhqicend.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key-from-supabase-dashboard>

# ─────────────────────────────────────────────
# Required: Cron authentication
# ─────────────────────────────────────────────
CRON_SECRET=<generate-a-strong-random-secret-e.g.-openssl-rand-hex-32>

# ─────────────────────────────────────────────
# AI Primary provider (choose ONE)
# ─────────────────────────────────────────────

# Option A: Google Gemini (default)
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-gemini-api-key-from-aistudio.google.com>
AI_MODEL=gemini-2.5-flash

# Option B: Anthropic Claude (uncomment and set AI_PROVIDER=anthropic)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# AI_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────
# AI Backup provider (optional — defaults to same provider as primary)
# Used automatically if the primary fails with a retryable or auth error.
# ─────────────────────────────────────────────

# Example: backup to a cheaper Gemini model
AI_BACKUP_PROVIDER=gemini
# AI_BACKUP_MODEL=gemini-2.0-flash-lite   # defaults to gemini-2.0-flash-lite

# Example: backup to Claude Haiku if primary is Gemini (cross-provider)
# AI_BACKUP_PROVIDER=anthropic
# AI_BACKUP_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=<your-key>             # required if backup is anthropic

# Legacy name (still honoured for backward compatibility):
# AI_FALLBACK_MODEL=gemini-2.0-flash-lite

# ─────────────────────────────────────────────
# Timing and reliability (all optional, sensible defaults shown)
# ─────────────────────────────────────────────

# Per-attempt HTTP timeout (ms). Default: 25000 (25 s)
# LLM_TIMEOUT_MS=25000

# Total wall-clock budget across all three LLM calls (ms). Default: 100000 (100 s)
# LLM_TOTAL_BUDGET_MS=100000

# Gap between sequential LLM calls (ms). Default: 1500
# LLM_GAP_MS=1500

# ─────────────────────────────────────────────
# Timezone (default: Asia/Kolkata)
# ─────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
