# Required Supabase configuration
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# AI provider credentials
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# AI provider and model selection
AI_PROVIDER=<YOUR_AI_PROVIDER>
AI_MODEL=<YOUR_AI_MODEL>
AI_FALLBACK_MODEL=<YOUR_AI_FALLBACK_MODEL>
AI_BACKUP_PROVIDER=<YOUR_AI_BACKUP_PROVIDER>
AI_BACKUP_MODEL=<YOUR_AI_BACKUP_MODEL>
AI_DEEP_PROVIDER=<YOUR_AI_DEEP_PROVIDER>
AI_DEEP_MODEL=<YOUR_AI_DEEP_MODEL>

# Scheduling and request limits
APP_TIMEZONE=<YOUR_TIMEZONE>
CRON_SECRET=<YOUR_CRON_SECRET>
LLM_GAP_MS=<MILLISECONDS>
LLM_TIMEOUT_MS=<MILLISECONDS>
LLM_TOTAL_BUDGET_MS=<MILLISECONDS>
WEEKLY_GAP_MS=<MILLISECONDS>
WEEKLY_STEP_TIMEOUT_MS=<MILLISECONDS>
WEEKLY_TOTAL_BUDGET_MS=<MILLISECONDS>
